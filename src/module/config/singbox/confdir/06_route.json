{
  "route": {
    "default_domain_resolver": "dns-direct",
    "default_http_client": "rule-set-download",
    "rule_set": [
      {
        "tag": [
          "block",
          "direct",
          "proxy"
        ],
        "type": "local",
        "format": "source",
        "path": "./rules/local/{tag}.json"
      },
      {
        "tag": [
          "Ads_AWAvenue",
          "AppleCN",
          "ChinaDomain",
          "ChinaIP",
          "Proxy"
        ],
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/Repcz/Tool/X/sing-box/Rules/{tag}.srs",
        "update_interval": "24h",
        "path": "./rules/remote/{tag}.srs"
      },
      {
        "type": "remote",
        "tag": "google",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geosite/google.srs",
        "update_interval": "24h",
        "path": "./source/remote/google.srs"
      }
    ],
    "rules": [
      {
        "action": "sniff",
        "timeout": "1s"
      },
      {
        "action": "sniff-override-destination"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 53
          },
          {
            "protocol": "dns"
          }
        ],
        "action": "hijack-dns"
      },
      {
        "clash_mode": "Direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "clash_mode": "Global",
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "rule_set": [
          "direct",
          "AppleCN"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "proxy"
        ],
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          {
            "clash_mode": "AllowAds",
            "invert": true
          },
          {
            "rule_set": [
              "block",
              "Ads_AWAvenue"
            ]
          }
        ],
        "action": "reject"
      },
      {
        "rule_set": [
          "google"
        ],
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "rule_set": [
          "ChinaDomain"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "Proxy"
        ],
        "action": "route",
        "outbound": "Proxy"
      },
      {
        "action": "resolve",
        "match_only": true,
        "strategy": "prefer_ipv4",
        "server": "cloudflare"
      },
      {
        "rule_set": "ChinaIP",
        "action": "route",
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      }
    ],
    "find_process": true,
    "final": "Proxy"
  }
}
