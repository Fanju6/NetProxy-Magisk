#!/system/bin/sh
#######################################
# 文件: netproxyctl
# 功能: NetProxy 唯一管理入口；业务由 netproxy-native 负责，Shell 只保留
#       Android 生命周期适配、参数转发和固定输出契约。
# 用法: netproxyctl [--json] <命令组> <命令> [参数]
# 依赖: common.sh、netproxy-native、core/service.sh。
#######################################

set -u

readonly MODDIR="$(cd "$(dirname "$0")/.." && pwd)"
readonly CONFIG_DIR="$MODDIR/config"
readonly MODULE_CONF="$CONFIG_DIR/module.conf"
readonly EBPF_CONF="$CONFIG_DIR/ebpf/ebpf.conf"
readonly CATALOG_DIR="$CONFIG_DIR/catalog"
readonly NETPROXY_NATIVE_BIN="$MODDIR/bin/netproxy-native"
readonly SING_BOX_BIN="$MODDIR/bin/sing-box"
readonly SERVICE_SCRIPT="$MODDIR/scripts/core/service.sh"
readonly SERVICE_STATE_FILE="$CONFIG_DIR/runtime/service.json"
readonly SUB_RUNTIME_DIR="${SUB_RUNTIME_DIR:-/dev/netproxy/subscriptions}"

. "$MODDIR/scripts/utils/common.sh"

OUTPUT_JSON=0
if [ "${1:-}" = "--json" ]; then
  OUTPUT_JSON=1
  shift
fi

#######################################
# 输出成功结果
# 参数:
#   $1  结果代码
#   $2  中文说明
#   $3  data JSON，可选
# 返回: 无
#######################################
emit_success() {
  local code="$1"
  local message="$2"
  local data="${3:-{}}"
  printf '{"schema":1,"ok":true,"code":"%s","message":"%s","data":%s}\n' \
    "$(json_escape "$code")" "$(json_escape "$message")" "$data"
}

#######################################
# 输出失败结果并退出
# 参数:
#   $1  结果代码
#   $2  中文说明
#   $3  退出码，可选
# 返回: 不返回
#######################################
emit_error() {
  local code="$1"
  local message="$2"
  local status="${3:-1}"
  printf '{"schema":1,"ok":false,"code":"%s","message":"%s","data":{}}\n' \
    "$(json_escape "$code")" "$(json_escape "$message")"
  exit "$status"
}

#######################################
# 调用 Go 业务入口并保留 stdout/stderr 契约
# 参数: netproxy-native 的完整参数
# 返回: 原样转发成功 JSON；失败时转发最后一份结构化错误
#######################################
native_call() {
  local error_file status native_error
  mkdir -p /dev/netproxy 2> /dev/null || true
  error_file="/dev/netproxy/netproxyctl.$$.err"
  "$NETPROXY_NATIVE_BIN" "$@" 2> "$error_file"
  status=$?
  if [ "$status" -eq 0 ]; then
    cat "$error_file" >&2 2> /dev/null || true
    rm -f "$error_file"
    return 0
  fi
  grep -v '"schema":1' "$error_file" >&2 2> /dev/null || true
  native_error="$(grep '"schema":1' "$error_file" 2> /dev/null | tail -n 1 || true)"
  if [ -n "$native_error" ]; then
    printf '%s\n' "$native_error"
    rm -f "$error_file"
    return "$status"
  fi
  rm -f "$error_file"
  emit_error "command.failed" "原生业务操作失败" "$status"
}

#######################################
# 调用 Go 模块业务服务
# 参数: module 子命令及参数
# 返回: 原样转发 schema=1 结果
#######################################
module_call() {
  native_call module "$@"
}

#######################################
# 调用控制快照服务
# 参数: control 子命令及参数
# 返回: 原样转发 schema=1 结果
#######################################
control_call() {
  native_call control "$@" \
    --catalog-root "$CATALOG_DIR" \
    --module-config "$MODULE_CONF" \
    --state-file "$SERVICE_STATE_FILE" \
    --progress-dir "$SUB_RUNTIME_DIR" \
    --worker-pid-file "/dev/netproxy/subworker.pid" \
    --sing-box "$SING_BOX_BIN" \
    --address "127.0.0.1:9090" \
    --secret "singbox"
}

#######################################
# 服务命令组
# 参数: status|start|stop|restart|reload|check
# 返回: schema=1 结果
#######################################
command_service() {
  local action="${1:-status}"
  case "$action" in
    status)
      control_call status --format json
      ;;
    start | stop | restart | reload | check)
      if sh "$SERVICE_SCRIPT" "$action" >&2; then
        emit_success "service.$action" "服务操作完成" "{\"action\":\"$action\"}"
      else
        emit_error "service.${action}_failed" "服务操作失败"
      fi
      ;;
    *) emit_error "usage.invalid" "用法: netproxyctl service status|start|stop|restart|reload|check" 2 ;;
  esac
}

#######################################
# Catalog 命令组
# 参数: list|show [分组]
# 返回: schema=1 结果
#######################################
command_catalog() {
  local action="${1:-list}"
  case "$action" in
    list)
      native_call catalog groups --root "$CATALOG_DIR" --module-config "$MODULE_CONF" --type all --format json
      ;;
    show)
      [ -n "${2:-}" ] || emit_error "usage.invalid" "用法: netproxyctl catalog show <分组>" 2
      native_call catalog show --root "$CATALOG_DIR" --group "$2" --format json
      ;;
    *) emit_error "usage.invalid" "用法: netproxyctl catalog list|show" 2 ;;
  esac
}

#######################################
# 节点命令组
# 参数: list|snapshot|current|show|get|export|delay|add|import|edit|remove|use
# 返回: schema=1 结果
#######################################
command_node() {
  local action="${1:-list}"
  shift 2> /dev/null || true
  local target="${1:-}" group="${2:-}" group_id tag

  case "$action" in
    list)
      if [ -n "$target" ]; then
        control_call nodes --group "$target" --format json
      else
        control_call nodes --format json
      fi
      ;;
    snapshot)
      if [ -n "$target" ]; then
        control_call snapshot --group "$target" --format json
      else
        control_call snapshot --format json
      fi
      ;;
    current)
      control_call selection --format json
      ;;
    show)
      [ -n "$target" ] || emit_error "usage.invalid" "用法: netproxyctl node show <分组>" 2
      native_call catalog show --root "$CATALOG_DIR" --group "$target" --format json
      ;;
    get | export)
      group_id="${target%%/*}"
      tag="${target#*/}"
      [ "$group_id" != "$target" ] && [ -n "$tag" ] \
        || emit_error "node.ref_invalid" "节点引用格式应为 <group-id>/<tag>" 2
      if [ "$action" = "get" ]; then
        native_call catalog node-get --root "$CATALOG_DIR" --group "$group_id" --tag "$tag"
      else
        native_call catalog node-export --root "$CATALOG_DIR" --group "$group_id" --tag "$tag"
      fi
      ;;
    add)
      [ -n "$target" ] || emit_error "usage.invalid" "用法: netproxyctl node add <节点链接>" 2
      if [ -n "$group" ]; then
        module_call node add --module-dir "$MODDIR" --catalog-root "$CATALOG_DIR" \
          --module-config "$MODULE_CONF" --ebpf-config "$EBPF_CONF" "$target" "$group"
      else
        module_call node add --module-dir "$MODDIR" "$target"
      fi
      ;;
    import)
      [ -n "$target" ] || emit_error "usage.invalid" "用法: netproxyctl node import <文件> [名称]" 2
      if [ -n "$group" ]; then
        module_call node import --module-dir "$MODDIR" --name "$group" "$target"
      else
        module_call node import --module-dir "$MODDIR" "$target"
      fi
      ;;
    edit)
      [ -n "$target" ] && [ -n "$group" ] \
        || emit_error "usage.invalid" "用法: netproxyctl node edit <分组/tag> <节点链接|文件>" 2
      module_call node edit --module-dir "$MODDIR" "$target" "$group"
      ;;
    remove | rm)
      [ -n "$target" ] || emit_error "usage.invalid" "用法: netproxyctl node remove <分组/tag>" 2
      module_call node remove --module-dir "$MODDIR" "$target"
      ;;
    use)
      [ -n "$target" ] || emit_error "usage.invalid" "用法: netproxyctl node use <分组/tag|auto> [分组]" 2
      if [ "$target" = "auto" ]; then
        if [ -n "$group" ]; then
          module_call select --module-dir "$MODDIR" auto "$group"
        else
          module_call select --module-dir "$MODDIR" auto
        fi
      else
        module_call select --module-dir "$MODDIR" "$target"
      fi
      ;;
    delay)
      control_call delay --target "$target" --group "$group" --format json
      ;;
    *) emit_error "usage.invalid" "用法: netproxyctl node list|snapshot|current|show|get|export|delay|add|import|edit|remove|use" 2 ;;
  esac
}

#######################################
# 订阅命令组
# 参数: list|show|add|edit|update|update-all|activate|remove|history|cancel
# 返回: schema=1 结果
#######################################
command_sub() {
  local action="${1:-list}"
  shift 2> /dev/null || true
  case "$action" in
    list | show | add | edit | update | update-all | activate | remove | history | cancel)
    module_call sub "$action" --module-dir "$MODDIR" --progress-dir "$SUB_RUNTIME_DIR" "$@"
      ;;
    *) emit_error "usage.invalid" "用法: netproxyctl sub list|show|add|edit|update|update-all|activate|remove|history|cancel" 2 ;;
  esac
}

#######################################
# 出站模式命令组
# 参数: 空值或 rule|global|direct|AllowAds
# 返回: schema=1 结果
#######################################
command_mode() {
  module_call mode --module-dir "$MODDIR" "$@"
}

#######################################
# 分应用代理命令组
# 参数: list|mode|users|add|remove|enable|disable
# 返回: schema=1 结果
#######################################
command_app() {
  local action="${1:-list}"
  shift 2> /dev/null || true
  module_call app "$action" --module-dir "$MODDIR" "$@"
}

#######################################
# eBPF 配置诊断命令组
# 参数: diagnose|validate；运行态探测仍由专用诊断工具负责。
# 返回: schema=1 结果
#######################################
command_ebpf() {
  local action="${1:-diagnose}"
  case "$action" in
    diagnose | validate | status)
      native_call ebpf diagnose --config "$EBPF_CONF" --format json
      ;;
    *) emit_error "usage.invalid" "用法: netproxyctl ebpf status|diagnose|validate" 2 ;;
  esac
}

#######################################
# 配置事务命令组
# 参数: list|read|check|validate|apply
# 返回: schema=1 结果
#######################################
command_config() {
  local action="${1:-}" target="${2:-}" source="${3:-}"
  case "$action" in
    list | check)
      module_call config "$action" --module-dir "$MODDIR"
      ;;
    read)
      [ -n "$target" ] || emit_error "usage.invalid" "用法: netproxyctl config read <目标>" 2
      module_call config read --module-dir "$MODDIR" "$target"
      ;;
    validate | apply)
      [ -n "$target" ] && [ -n "$source" ] \
        || emit_error "usage.invalid" "用法: netproxyctl config $action <目标> <内容文件>" 2
      module_call config "$action" --module-dir "$MODDIR" "$target" "$source"
      ;;
    *) emit_error "usage.invalid" "用法: netproxyctl config list|read|check|validate|apply" 2 ;;
  esac
}

#######################################
# 日志和诊断命令组
# 参数: show|clear|export [service|core|sub]
# 返回: schema=1 结果
#######################################
command_logs() {
  local action="${1:-show}"
  shift 2> /dev/null || true
  local kind="${1:-service}"
  case "$action" in
    show)
      if [ "$OUTPUT_JSON" = "1" ]; then
        module_call logs show --module-dir "$MODDIR" --format json --lines "${2:-200}" "$kind"
      else
        module_call logs show --module-dir "$MODDIR" --format text --lines "${2:-200}" "$kind"
      fi
      ;;
    clear)
      module_call logs clear --module-dir "$MODDIR" "$kind"
      ;;
    export)
      module_call logs export --module-dir "$MODDIR" "${kind:-/sdcard/Download/netproxy-diagnostics.tar.gz}"
      ;;
    *) emit_error "usage.invalid" "用法: netproxyctl logs show|clear|export" 2 ;;
  esac
}

#######################################
# 显示帮助
# 参数: 无
# 返回: 无
#######################################
show_help() {
  cat << EOF
NetProxy 管理命令

用法:
  netproxyctl [--json] service status|start|stop|restart|reload
  netproxyctl [--json] catalog list|show <分组>
  netproxyctl [--json] node list|current|show|get|export|delay|add|import|edit|remove|use
  netproxyctl [--json] sub list|show|add|edit|update|update-all|activate|remove|history|cancel
  netproxyctl [--json] mode [rule|global|direct|AllowAds]
  netproxyctl [--json] app list|mode|users|add|remove|enable|disable
  netproxyctl [--json] ebpf status|diagnose
  netproxyctl [--json] config list|read|check|validate|apply
  netproxyctl [--json] logs show|clear|export

节点引用固定为 <group-id>/<tag>；自动模式使用 node use auto [分组]。
stdout 只包含 schema=1 结果，运行日志写入 stderr。
EOF
}

#######################################
# 主入口
# 参数: 命令组和命令参数
# 返回: 由对应命令组返回
#######################################
case "${1:-help}" in
  service) shift; command_service "$@" ;;
  catalog) shift; command_catalog "$@" ;;
  node) shift; command_node "$@" ;;
  sub) shift; command_sub "$@" ;;
  mode) shift; command_mode "$@" ;;
  app) shift; command_app "$@" ;;
  ebpf) shift; command_ebpf "$@" ;;
  config) shift; command_config "$@" ;;
  logs) shift; command_logs "$@" ;;
  help | -h | --help) show_help ;;
  *) emit_error "usage.invalid" "未知命令组，使用 netproxyctl help 查看帮助" 2 ;;
esac
