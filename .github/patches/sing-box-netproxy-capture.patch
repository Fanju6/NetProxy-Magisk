+package route
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net"
+	"os"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	N "github.com/sagernet/sing/common/network"
+	"golang.org/x/sys/unix"
+)
+
+func (m *ConnectionManager) netProxyCapture(ctx context.Context, client, upstream net.Conn, metadata adapter.InboundContext, onClose N.CloseHandlerFunc) bool {
+	deadline := time.Now().Add(250 * time.Millisecond)
+	dialer := net.Dialer{Deadline: deadline}
+	conn, err := dialer.DialContext(ctx, "unix", m.NetProxyCaptureSocket)
+	if err != nil {
+		return false
+	}
+	bridge := conn.(*net.UnixConn)
+	_ = bridge.SetDeadline(deadline)
+	fds, err := unix.Socketpair(unix.AF_UNIX, unix.SOCK_STREAM|unix.SOCK_CLOEXEC, 0)
+	if err != nil {
+		bridge.Close()
+		return false
+	}
+	local := os.NewFile(uintptr(fds[0]), "netproxy-core")
+	peer := os.NewFile(uintptr(fds[1]), "netproxy-worker")
+	defer local.Close()
+	defer peer.Close()
+	remoteBridge, err := net.FileConn(local)
+	if err != nil {
+		bridge.Close()
+		return false
+	}
+	exit := netProxyExit(metadata, upstream)
+	info, _ := json.Marshal(struct {
+		Destination string `json:"destination"`
+		Host        string `json:"host,omitempty"`
+		Outbound    string `json:"outbound"`
+		Exit        any    `json:"exit"`
+	}{metadata.Destination.String(), metadata.SniffHost, netProxyLabel(metadata.RouteOutbound, 128), exit})
+	info = append(info, '\n')
+	n, _, err := bridge.WriteMsgUnix(info, unix.UnixRights(int(peer.Fd())), nil)
+	if err != nil || n != len(info) {
+		bridge.Close()
+		remoteBridge.Close()
+		return false
+	}
+	var ready [1]byte
+	if _, err := io.ReadFull(bridge, ready[:]); err != nil || ready[0] != 1 {
+		bridge.Close()
+		remoteBridge.Close()
+		return false
+	}
+	_ = bridge.SetDeadline(time.Time{})
+	go func() {
+		var done atomic.Bool
+		if m.kickWriteHandshake(ctx, client, upstream, true, false, &done, onClose) ||
+			m.kickWriteHandshake(ctx, upstream, client, true, true, &done, onClose) {
+			_ = bridge.Close()
+			_ = remoteBridge.Close()
+			return
+		}
+		netProxyCaptureRelay(client, bridge, upstream, remoteBridge, onClose)
+	}()
+	return true
+}
+
+func netProxyLabel(value string, limit int) string {
+	if len(value) > limit {
+		return value[:limit]
+	}
+	return value
+}
+
+func netProxyExit(metadata adapter.InboundContext, upstream net.Conn) any {
+	type hop struct {
+		Tag  string `json:"tag"`
+		Type string `json:"type"`
+	}
+	exit := struct {
+		Inbound string `json:"inbound"`
+		Chain   []hop  `json:"chain,omitempty"`
+		Remote  string `json:"remote,omitempty"`
+		Package string `json:"package,omitempty"`
+		UID     *int32 `json:"uid,omitempty"`
+		Process string `json:"process,omitempty"`
+	}{Inbound: metadata.Inbound}
+	for i, outbound := range metadata.OutboundChain {
+		if i >= 8 && i != len(metadata.OutboundChain)-1 {
+			continue
+		}
+		exit.Chain = append(exit.Chain, hop{netProxyLabel(outbound.Tag(), 128), netProxyLabel(outbound.Type(), 32)})
+	}
+	if remote := upstream.RemoteAddr(); remote != nil {
+		exit.Remote = netProxyLabel(remote.String(), 256)
+	}
+	if owner := metadata.ProcessInfo; owner != nil {
+		if owner.UserId >= 0 {
+			exit.UID = &owner.UserId
+		}
+		if len(owner.PackageNames) == 1 {
+			exit.Package = netProxyLabel(owner.PackageNames[0], 256)
+		}
+		if len(owner.ProcessPaths) == 1 {
+			exit.Process = netProxyLabel(owner.ProcessPaths[0], 256)
+		}
+	}
+	return exit
+}
+
+func netProxyCaptureRelay(client, bridge, upstream, remoteBridge net.Conn, onClose N.CloseHandlerFunc) {
+	var wait sync.WaitGroup
+	for _, pair := range [][2]net.Conn{{client, bridge}, {bridge, client}, {upstream, remoteBridge}, {remoteBridge, upstream}} {
+		wait.Go(func() {
+			_, _ = io.Copy(pair[1], pair[0])
+			if closer, ok := pair[1].(interface{ CloseWrite() error }); ok {
+				_ = closer.CloseWrite()
+			} else {
+				_ = pair[1].Close()
+			}
+		})
+	}
+	wait.Wait()
+	client.Close()
+	bridge.Close()
+	upstream.Close()
+	remoteBridge.Close()
+	if onClose != nil {
+		onClose(nil)
+	}
+}
