+package route
+
+import (
+	"net/netip"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	R "github.com/sagernet/sing-box/route/rule"
+	M "github.com/sagernet/sing/common/metadata"
+	"github.com/stretchr/testify/require"
+)
+
+func TestNetProxySniffDestination(t *testing.T) {
+	ip := M.ParseSocksaddr("192.0.2.1:443")
+	domain := M.ParseSocksaddr("example.com:443")
+	tests := []struct {
+		name, inbound, outbound, host     string
+		destination, explicit             M.Socksaddr
+		packet, bypass, ech, off, rewrite bool
+	}{
+		{name: "TCP", inbound: "netproxy-in", outbound: C.TypeVLESS, host: "example.com", destination: ip, rewrite: true},
+		{name: "UDP", inbound: "netproxy-in", outbound: C.TypeVLESS, host: "example.com", destination: ip, packet: true, rewrite: true},
+		{name: "direct leaf", inbound: "netproxy-in", outbound: C.TypeDirect, host: "example.com", destination: ip},
+		{name: "block leaf", inbound: "netproxy-in", outbound: C.TypeBlock, host: "example.com", destination: ip},
+		{name: "bypass action", inbound: "netproxy-in", outbound: C.TypeVLESS, host: "example.com", destination: ip, bypass: true},
+		{name: "other inbound", inbound: "mixed-in", outbound: C.TypeVLESS, host: "example.com", destination: ip},
+		{name: "original hostname", inbound: "netproxy-in", outbound: C.TypeVLESS, host: "other.example.com", destination: domain},
+		{name: "explicit route override", inbound: "netproxy-in", outbound: C.TypeVLESS, host: "example.com", destination: ip, explicit: M.ParseSocksaddr("192.0.2.2:443")},
+		{name: "no sniff host", inbound: "netproxy-in", outbound: C.TypeVLESS, destination: ip, packet: true},
+		{name: "ECH outer host", inbound: "netproxy-in", outbound: C.TypeVLESS, host: "example.com", destination: ip, ech: true},
+		{name: "disabled switch", inbound: "netproxy-in", outbound: C.TypeVLESS, host: "example.com", destination: ip, off: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			router := &Router{logger: log.NewNOPFactory().NewLogger("router"), netProxySniffDestination: !tt.off}
+			metadata := adapter.InboundContext{
+				Inbound: tt.inbound, SniffHost: tt.host, Destination: tt.destination, SniffHasECHExtension: tt.ech,
+				RouteOriginalDestination: tt.explicit, DestinationAddresses: []netip.Addr{ip.Addr},
+			}
+			var rule adapter.Rule
+			if tt.bypass {
+				rule = &testL3Rule{action: &R.RuleActionBypass{Outbound: "proxy"}}
+			}
+			router.applyNetProxySniffDestination(t.Context(), &metadata, rule, &testFlowOutbound{outboundType: tt.outbound}, tt.packet)
+			if !tt.rewrite {
+				require.Equal(t, tt.destination, metadata.Destination)
+				require.Equal(t, []netip.Addr{ip.Addr}, metadata.DestinationAddresses)
+				require.False(t, metadata.DestOverride)
+				return
+			}
+			require.Equal(t, domain, metadata.Destination)
+			require.Empty(t, metadata.DestinationAddresses)
+			require.Equal(t, tt.packet, metadata.DestOverride)
+			if tt.packet {
+				require.Equal(t, ip, metadata.OriginDestination)
+				nat := newFakeIPNATPacketConn(nil, metadata.OriginDestination, metadata.Destination)
+				require.Equal(t, domain, nat.rewriteReadDestination(ip))
+				require.Equal(t, ip, nat.rewriteWriteDestination(domain))
+			}
+		})
+	}
+}
+
+type netProxyPacketIPOutbound struct{ testFlowOutbound }
+
+func (*netProxyPacketIPOutbound) NetProxyPacketDestinationIPOnly() bool { return true }
+
+type netProxyDNSManager struct {
+	adapter.DNSTransportManager
+	proxy adapter.DNSTransport
+}
+
+func (m *netProxyDNSManager) Transport(tag string) (adapter.DNSTransport, bool) {
+	return m.proxy, tag == "dns-proxy" && m.proxy != nil
+}
+
+func TestNetProxySniffDestinationPacketAddr(t *testing.T) {
+	original := M.ParseSocksaddr("192.0.2.1:443")
+	clean := M.ParseSocksaddr("203.0.113.1:443")
+	resolver := &testL3DNSRouter{addresses: []netip.Addr{clean.Addr}}
+	router := &Router{
+		logger: log.NewNOPFactory().NewLogger("router"), dns: resolver,
+		dnsTransport:             &netProxyDNSManager{proxy: new(struct{ adapter.DNSTransport })},
+		netProxySniffDestination: true,
+	}
+	metadata := adapter.InboundContext{Inbound: "netproxy-in", Destination: original, SniffHost: "example.com"}
+	outbound := &netProxyPacketIPOutbound{testFlowOutbound{outboundType: C.TypeVLESS}}
+	router.applyNetProxySniffDestination(t.Context(), &metadata, nil, outbound, true)
+	require.Equal(t, "example.com", resolver.domain)
+	require.NotNil(t, resolver.options.Transport)
+	require.Equal(t, clean, metadata.Destination)
+	require.Equal(t, original, metadata.OriginDestination)
+	require.True(t, metadata.DestOverride)
+}
