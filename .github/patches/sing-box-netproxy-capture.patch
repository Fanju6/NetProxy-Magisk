+package route
+
+import (
+	"context"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	R "github.com/sagernet/sing-box/route/rule"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+func (r *Router) applyNetProxySniffDestination(ctx context.Context, metadata *adapter.InboundContext, rule adapter.Rule, outbound adapter.Outbound, packet bool) {
+	if !r.netProxySniffDestination || metadata.Inbound != "netproxy-in" || !metadata.Destination.IsIP() ||
+		metadata.RouteOriginalDestination.IsValid() || metadata.FakeIP || metadata.DestOverride ||
+		metadata.SniffHasECHExtension || !M.IsDomainName(metadata.SniffHost) {
+		return
+	}
+	if rule != nil {
+		if _, bypass := rule.Action().(*R.RuleActionBypass); bypass {
+			return
+		}
+	}
+	switch outbound.Type() {
+	case C.TypeDirect, C.TypeBlock, C.TypePass, C.TypeDNS, C.TypeBridge:
+		return
+	}
+	destination := M.Socksaddr{Fqdn: metadata.SniffHost, Port: metadata.Destination.Port}
+	if packet {
+		if ipOnly, ok := outbound.(interface{ NetProxyPacketDestinationIPOnly() bool }); ok && ipOnly.NetProxyPacketDestinationIPOnly() {
+			transport, ok := r.dnsTransport.Transport("dns-proxy")
+			if !ok {
+				return
+			}
+			addresses, err := r.dns.Lookup(adapter.WithContext(ctx, metadata), destination.Fqdn, adapter.DNSQueryOptions{
+				Transport: transport,
+			})
+			if err != nil || len(addresses) == 0 {
+				r.logger.DebugContext(ctx, "cannot resolve sniffed packet destination: ", destination.Fqdn, ": ", err)
+				return
+			}
+			destination = M.SocksaddrFrom(addresses[0], destination.Port)
+		}
+		metadata.OriginDestination = metadata.Destination
+		metadata.DestOverride = true
+	}
+	metadata.Destination = destination
+	metadata.DestinationAddresses = nil
+	r.logger.DebugContext(ctx, "managed proxy destination overridden as ", destination)
+}
