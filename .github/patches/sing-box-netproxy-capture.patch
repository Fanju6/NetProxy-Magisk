@@ -0,0 +1,154 @@
+//go:build with_ebpf && (linux || android)
+
+package ebpf
+
+import (
+	"errors"
+	"math/bits"
+	"os"
+
+	commonEBPF "github.com/CHIZI-0618/sing-ebpf"
+	bpf "github.com/cilium/ebpf"
+	"github.com/cilium/ebpf/asm"
+	"github.com/cilium/ebpf/link"
+	"golang.org/x/sys/unix"
+)
+
+type rejectUIDPrefix struct {
+	Bits uint32
+	UID  [4]byte
+}
+
+func rejectUIDPrefixes(start, end uint32) []rejectUIDPrefix {
+	var prefixes []rejectUIDPrefix
+	for first, last := uint64(start), uint64(end); first <= last; {
+		width := min(bits.TrailingZeros64(first), bits.Len64(last-first+1)-1)
+		prefixes = append(prefixes, rejectUIDPrefix{32 - uint32(width),
+			[4]byte{byte(first >> 24), byte(first >> 16), byte(first >> 8), byte(first)},
+		})
+		first += uint64(1) << width
+	}
+	return prefixes
+}
+
+func (i *Inbound) startLocalIPv6Rejection() error {
+	if !i.rejectLocalIPv6 {
+		return nil
+	}
+	path := i.cgroupPath
+	if path == "" {
+		var err error
+		path, err = commonEBPF.DetectCgroup2Root()
+		if err != nil {
+			return err
+		}
+	}
+	group, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer group.Close()
+
+	decisions, defaultAction := i.compileProcessUIDPolicy()
+	entries := make(map[rejectUIDPrefix]uint32)
+	for _, decision := range decisions {
+		for _, prefix := range rejectUIDPrefixes(decision.Start, decision.End) {
+			if decision.Action == commonEBPF.DecisionPass {
+				entries[prefix] = 1
+			} else {
+				entries[prefix] = 0
+			}
+		}
+	}
+	policy, err := bpf.NewMap(&bpf.MapSpec{
+		Type: bpf.LPMTrie, KeySize: 8, ValueSize: 4,
+		MaxEntries: uint32(max(1, len(entries))), Flags: unix.BPF_F_NO_PREALLOC,
+	})
+	if err != nil {
+		return err
+	}
+	defer policy.Close()
+	for prefix, action := range entries {
+		if err := policy.Put(prefix, action); err != nil {
+			return err
+		}
+	}
+
+	defaultResult := int32(0)
+	if defaultAction == commonEBPF.DecisionPass {
+		defaultResult = 1
+	}
+	attachments := []bpf.AttachType{bpf.AttachCGroupInet6Connect}
+	if i.enableUDP {
+		attachments = append(attachments, bpf.AttachCGroupUDP6Sendmsg)
+	}
+	for _, attach := range attachments {
+		program, err := bpf.NewProgram(&bpf.ProgramSpec{
+			Name: "np_ipv6_reject", Type: bpf.CGroupSockAddr, AttachType: attach,
+			License: "GPL", Instructions: rejectIPv6Instructions(policy.FD(), os.Getpid(), defaultResult, i.enableTCP, i.enableUDP),
+		})
+		if err != nil {
+			return err
+		}
+		attached, err := link.AttachRawLink(link.RawLinkOptions{Target: int(group.Fd()), Program: program, Attach: attach})
+		program.Close()
+		if err != nil {
+			return err
+		}
+		i.localIPv6RejectLinks = append(i.localIPv6RejectLinks, attached.Close)
+	}
+	return nil
+}
+
+func (i *Inbound) closeLocalIPv6Rejection() error {
+	var err error
+	for _, closeLink := range i.localIPv6RejectLinks {
+		err = errors.Join(err, closeLink())
+	}
+	i.localIPv6RejectLinks = nil
+	return err
+}
+
+func rejectIPv6Instructions(policyFD, selfPID int, defaultResult int32, tcp, udp bool) asm.Instructions {
+	// bpf_sock_addr：IPv6 地址占字节 8–23，协议位于字节 36–39。
+	instructions := asm.Instructions{asm.LoadMem(asm.R2, asm.R1, 36, asm.Word)}
+	if !tcp {
+		instructions = append(instructions, asm.JEq.Imm(asm.R2, unix.IPPROTO_TCP, "pass"))
+	}
+	if !udp {
+		instructions = append(instructions, asm.JEq.Imm(asm.R2, unix.IPPROTO_UDP, "pass"))
+	}
+	return append(instructions,
+		asm.LoadMem(asm.R2, asm.R1, 8, asm.Word),
+		asm.JNE.Imm(asm.R2, 0, "self"),
+		asm.LoadMem(asm.R2, asm.R1, 12, asm.Word),
+		asm.JNE.Imm(asm.R2, 0, "self"),
+		asm.LoadMem(asm.R2, asm.R1, 16, asm.Word),
+		asm.HostTo(asm.BE, asm.R2, asm.Word),
+		asm.JEq.Imm(asm.R2, 0xffff, "pass"),
+		asm.JNE.Imm(asm.R2, 0, "self"),
+		asm.LoadMem(asm.R2, asm.R1, 20, asm.Word),
+		asm.HostTo(asm.BE, asm.R2, asm.Word),
+		asm.JLE.Imm(asm.R2, 1, "pass"),
+		// 核心可能和受管 Root 进程同为 UID 0，出站不能按 UID 一并拒绝。
+		asm.FnGetCurrentPidTgid.Call().WithSymbol("self"),
+		asm.RSh.Imm(asm.R0, 32),
+		asm.JEq.Imm(asm.R0, int32(selfPID), "pass"),
+		asm.FnGetCurrentUidGid.Call(),
+		asm.HostTo(asm.BE, asm.R0, asm.Word),
+		asm.StoreImm(asm.RFP, -8, 32, asm.Word),
+		asm.StoreMem(asm.RFP, -4, asm.R0, asm.Word),
+		asm.LoadMapPtr(asm.R1, policyFD),
+		asm.Mov.Reg(asm.R2, asm.RFP),
+		asm.Add.Imm(asm.R2, -8),
+		asm.FnMapLookupElem.Call(),
+		asm.JEq.Imm(asm.R0, 0, "default"),
+		asm.LoadMem(asm.R0, asm.R0, 0, asm.Word),
+		asm.And.Imm(asm.R0, 1),
+		asm.Return(),
+		asm.Mov.Imm(asm.R0, defaultResult).WithSymbol("default"),
+		asm.Return(),
+		asm.Mov.Imm(asm.R0, 1).WithSymbol("pass"),
+		asm.Return(),
+	)
+}
