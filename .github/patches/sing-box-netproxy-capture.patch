+//go:build with_ebpf && (linux || android)
+
+package ebpf
+
+import (
+	"net/netip"
+	"slices"
+	"testing"
+
+	"github.com/sagernet/sing/common"
+)
+
+func TestNetProxyLocalIPv6Policy(t *testing.T) {
+	for _, tt := range []struct {
+		name              string
+		local             bool
+		tag               string
+		ipv6              *bool
+		intercept, reject bool
+	}{
+		{"managed disabled", true, "netproxy-in", common.Ptr(false), true, true},
+		{"managed enabled", true, "netproxy-in", common.Ptr(true), true, false},
+		{"managed default", true, "netproxy-in", nil, true, false},
+		{"shared only", false, "netproxy-in", nil, false, false},
+		{"other inbound disabled", true, "custom", common.Ptr(false), false, false},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			intercept, reject := localIPv6Policy(tt.local, tt.tag, tt.ipv6)
+			if intercept != tt.intercept || reject != tt.reject {
+				t.Fatalf("intercept=%v reject=%v", intercept, reject)
+			}
+			i := Inbound{rejectLocalIPv6: reject}
+			v6 := netip.MustParseAddr("2001:db8::1")
+			if i.rejectsLocalIPv6(v6, true) != tt.reject || i.rejectsLocalIPv6(v6, false) ||
+				i.rejectsLocalIPv6(netip.MustParseAddr("::ffff:192.0.2.1"), true) {
+				t.Fatal("IPv6 rejection did not respect traffic scope or address family")
+			}
+		})
+	}
+}
+
+func TestNetProxyIPv6RejectUIDRanges(t *testing.T) {
+	for _, tt := range []struct {
+		start, end uint32
+		want       []rejectUIDPrefix
+	}{
+		{0, ^uint32(0), []rejectUIDPrefix{{Bits: 0}}},
+		{10418, 10418, []rejectUIDPrefix{{32, [4]byte{0, 0, 40, 178}}}},
+		{100000, 100003, []rejectUIDPrefix{{30, [4]byte{0, 1, 134, 160}}}},
+	} {
+		if got := rejectUIDPrefixes(tt.start, tt.end); !slices.Equal(got, tt.want) {
+			t.Fatalf("range %d..%d: got %+v, want %+v", tt.start, tt.end, got, tt.want)
+		}
+	}
+}
