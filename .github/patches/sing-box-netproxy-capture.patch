+package route
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"net"
+	"sync"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+type netProxyReplayKey struct{}
+
+type netProxyReplay struct {
+	conn net.Conn
+	once sync.Once
+}
+
+func (r *Router) startNetProxyReplay(path string, scope *adapter.Scope) {
+	ctx, cancel := context.WithCancel(r.ctx)
+	scope.Add(func() error {
+		cancel()
+		return nil
+	})
+	go func() {
+		var dialer net.Dialer
+		slots := make(chan struct{}, 4)
+		for ctx.Err() == nil {
+			conn, err := dialer.DialContext(ctx, "unix", path)
+			if err == nil {
+				if r.acceptNetProxyReplay(ctx, conn, slots) {
+					continue
+				}
+				conn.Close()
+			}
+			timer := time.NewTimer(time.Second)
+			select {
+			case <-ctx.Done():
+				timer.Stop()
+				return
+			case <-timer.C:
+			}
+		}
+	}()
+}
+
+func (r *Router) acceptNetProxyReplay(ctx context.Context, conn net.Conn, slots chan struct{}) bool {
+	stop := context.AfterFunc(ctx, func() { conn.Close() })
+	defer stop()
+	if _, err := conn.Write([]byte{0}); err != nil {
+		return false
+	}
+	line, err := bufio.NewReaderSize(conn, 2048).ReadSlice('\n')
+	if err != nil {
+		return false
+	}
+	var request struct {
+		Destination string `json:"destination"`
+		UID         *int32 `json:"uid"`
+		UserID      uint32 `json:"user_id"`
+		Package     string `json:"package"`
+	}
+	if json.Unmarshal(line, &request) != nil {
+		return false
+	}
+	destination := M.ParseSocksaddr(request.Destination)
+	inbound, ok := r.inbound.Get("netproxy-in")
+	if !ok || !destination.IsValid() || destination.Port == 0 {
+		return false
+	}
+	metadata := adapter.InboundContext{
+		Inbound: inbound.Tag(), InboundType: inbound.Type(), Network: N.NetworkTCP,
+		Destination: destination, OriginDestination: destination,
+	}
+	if request.UID != nil && *request.UID >= 0 && uint32(*request.UID)/100000 == request.UserID && request.Package != "" && len(request.Package) <= 256 {
+		metadata.ProcessInfo = &adapter.ConnectionOwner{UserId: *request.UID, PackageNames: []string{request.Package}}
+	}
+	select {
+	case slots <- struct{}{}:
+	default:
+		return false
+	}
+	if _, err := conn.Write([]byte{1}); err != nil {
+		<-slots
+		return false
+	}
+	go func() {
+		ctx, cancel := context.WithTimeout(ctx, 2*time.Minute)
+		defer cancel()
+		defer func() { <-slots }()
+		defer conn.Close()
+		_ = conn.SetDeadline(time.Now().Add(2 * time.Minute))
+		stop := context.AfterFunc(ctx, func() { conn.Close() })
+		defer stop()
+		replay := &netProxyReplay{conn: conn}
+		done := make(chan struct{})
+		r.RouteConnectionEx(context.WithValue(ctx, netProxyReplayKey{}, replay), conn, metadata, N.OnceClose(func(err error) {
+			replay.once.Do(func() {
+				_, _ = conn.Write([]byte("{\"error\":\"traffic.replay_route_failed\"}\n"))
+			})
+			close(done)
+		}))
+		select {
+		case <-done:
+		case <-ctx.Done():
+		}
+	}()
+	return true
+}
+
+func netProxyReplayConnected(ctx context.Context, metadata adapter.InboundContext, upstream net.Conn) (bool, error) {
+	replay, ok := ctx.Value(netProxyReplayKey{}).(*netProxyReplay)
+	if !ok {
+		return false, nil
+	}
+	var err error
+	replay.once.Do(func() {
+		err = json.NewEncoder(replay.conn).Encode(struct {
+			Outbound string `json:"outbound"`
+			Exit     any    `json:"exit"`
+		}{netProxyLabel(metadata.RouteOutbound, 128), netProxyExit(metadata, upstream)})
+	})
+	return true, err
+}
