<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application>
        <service
            android:name="com.fanjv.netproxy.NetProxyTileService"
            android:exported="true"
            android:icon="@drawable/ic_netproxy_tile"
            android:label="@string/netproxy_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <provider
            android:name="com.fanjv.netproxy.bridge.DiagnosticFileProvider"
            android:authorities="${applicationId}.netproxy.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/netproxy_diagnostic_paths" />
        </provider>
    </application>
</manifest>
